# Copy to .env (never committed; the PreToolUse hook blocks the agent from reading or editing .env*).
# Shared secret for /admin. Pick any long random string.
ADMIN_TOKEN=change-me
# Context7 MCP (current library docs): free key from https://context7.com/dashboard
CONTEXT7_API_KEY=ctx7sk-...
# Product data source on first start: live | snapshot (admin can switch it at runtime)
DATA_SOURCE=live
# API port (web dev server proxies /api to it)
PORT=4000
